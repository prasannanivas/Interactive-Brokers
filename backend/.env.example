# JWT Authentication Secret Key
# Generate a strong random secret key for production!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Watchlist Configuration
WATCHLIST_FILE=watchlist.json

# Telegram Bot Configuration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading Economics usage (monthly request quota)
# Bond yields / interest rates are fetched on demand when the dashboard views them.
# Set to true to bring back the 5 AM full refresh of every series.
SCHEDULED_ECONOMIC_REFRESH=false
# Intraday bond yields (1D view only, never more than the last day is fetched):
# minimum minutes between refreshes per series (one request covers all series on a chart)
INTRADAY_REFRESH_MINUTES=360
# Days of 1-minute bars kept in MongoDB
INTRADAY_RETENTION_DAYS=3
