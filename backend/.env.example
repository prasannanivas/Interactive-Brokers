# MASSIVE API Configuration
MASSIVE_API_KEY=your_massive_api_key_here

# MongoDB Configuration - DigitalOcean Managed Database
MONGODB_URL=mongodb+srv://Prasanna:3H41Al0q5Uvz976s@db-mongodb-sfo2-83953-82c5177a.mongo.ondigitalocean.com/trading_monitor?tls=true&authSource=admin&replicaSet=db-mongodb-sfo2-83953-82c5177a.mongo.ondigitalocean.com/admin?replicaSet=db-mongodb-sfo2-83953&tls=true&authSource=admin
